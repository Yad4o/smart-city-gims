# --- Database ---
DATABASE_URL=postgresql://user:password@host/smart_city_gims
# PostGIS must be enabled: CREATE EXTENSION IF NOT EXISTS postgis;

# --- Auth ---
SECRET_KEY=your-32-byte-hex-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- AI Categorization ---
OPENAI_API_KEY=sk-...
# Leave blank to force keyword-only fallback (no cost)
OPENAI_MODEL=gpt-4o-mini

# --- Email (Resend) ---
RESEND_API_KEY=re_...
EMAILS_FROM=noreply@smartcity.gov.in

# --- File Storage ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- App ---
APP_NAME=Smart City GIMS
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- SLA defaults (hours) ---
SLA_P1_HOURS=4
SLA_P2_HOURS=24
SLA_P3_HOURS=72
SLA_P4_HOURS=168
